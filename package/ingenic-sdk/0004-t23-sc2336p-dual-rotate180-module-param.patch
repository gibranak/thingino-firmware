From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gibranak <gibranhostel@gmail.com>
Date: Wed, 7 Oct 2026 00:00:00 +0000
Subject: [PATCH] t23: sc2336ps0/ps1 - add rotate180 module parameter

Add a rotate180 parameter for a sensor mounted upside down. The sensor
then applies mirror and flip itself (0x3221), so the picture is upright
before the ISP. Overlays drawn by the ISP stay readable, which they do
not when the ISP mirrors the image. Flips requested through
TX_ISP_EVENT_SENSOR_VFLIP are applied relative to this orientation, and
the orientation is restored in sensor_init after the register table.

Also fix sensor_set_vflip: it stored the return code of sensor_read()
in the register value, so the other bits of 0x3221 were lost.

diff --git a/3.10.14/sensor-src/t23/sc2336ps0.c b/3.10.14/sensor-src/t23/sc2336ps0.c
--- a/3.10.14/sensor-src/t23/sc2336ps0.c
+++ b/3.10.14/sensor-src/t23/sc2336ps0.c
@@ -70,6 +70,13 @@
 module_param(fsync_mode, int, S_IRUGO);
 MODULE_PARM_DESC(fsync_mode, "Sensor Indicates the frame synchronization mode");
 
+static int rotate180 = 0;
+module_param(rotate180, int, S_IRUGO);
+MODULE_PARM_DESC(rotate180, "Sensor mounted upside down: rotate output 180 degrees");
+
+/* Flip requested by the ISP, relative to the mounting orientation */
+static int flip_mode;
+
 struct regval_list {
 	uint16_t reg_num;
 	unsigned char value;
@@ -615,7 +622,7 @@
 
 	ret += sensor_read(sd, 0x3107, &v);
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
-	if (ret < 0)
+	if (ret)
 		return ret;
 	if (v != SENSOR_CHIP_ID_H && v != SENSOR_CHIP_ID_H_ALT)
 		return -ENODEV;
@@ -623,7 +630,7 @@
 
 	ret += sensor_read(sd, 0x3108, &v);
 	ISP_WARNING("-----%s: %d ret = %d, v = 0x%02x\n", __func__, __LINE__, ret,v);
-	if (ret < 0)
+	if (ret)
 		return ret;
 	if (v != SENSOR_CHIP_ID_L)
 		return -ENODEV;
@@ -649,7 +656,7 @@
 	ret += sensor_write(sd, 0x3e09, (unsigned char)(((again >> 8) & 0xff)));
 	//sensor dig fine gain
 	ret += sensor_write(sd, 0x3e07, (unsigned char)(again & 0xff));
-	if (ret < 0)
+	if (ret)
 		return ret;
 
 	return 0;
@@ -665,7 +672,7 @@
 	ret += sensor_write(sd, 0x3e01, (unsigned char)((value >> 4) & 0xff));
 	ret += sensor_write(sd, 0x3e02, (unsigned char)((value & 0x0f) << 4));
 
-	if (ret < 0)
+	if (ret)
 		return ret;
 
 	return 0;
@@ -677,7 +684,7 @@
 
 	ret += sensor_write(sd, 0x3e09, (unsigned char)(value & 0xff));
 	ret += sensor_write(sd, 0x3e08, (unsigned char)(((value >> 8) & 0xff)));
-	if (ret < 0)
+	if (ret)
 		return ret;
 	gain_val = value;
 
@@ -700,6 +707,24 @@
 	return 0;
 }
 
+/* 0x3221: bits 1-2 mirror, bits 5-6 flip; mode bit 0 mirror, bit 1 flip */
+static int sensor_apply_flip(struct tx_isp_subdev *sd)
+{
+	int mode = flip_mode ^ (rotate180 ? 3 : 0);
+	unsigned char val;
+	int ret;
+
+	ret = sensor_read(sd, 0x3221, &val);
+	if (ret)
+		return ret;
+	val &= 0x99;
+	if (mode & 1)
+		val |= 0x06;
+	if (mode & 2)
+		val |= 0x60;
+	return sensor_write(sd, 0x3221, val);
+}
+
 static int sensor_init(struct tx_isp_subdev *sd, int enable)
 {
 	struct tx_isp_sensor *sensor = sd_to_sensor_device(sd);
@@ -718,6 +743,9 @@
 	ret = sensor_write_array(sd, wsize->regs);
 	if (ret)
 		return ret;
+	ret = sensor_apply_flip(sd);
+	if (ret)
+		return ret;
 	ret = tx_isp_call_subdev_notify(sd, TX_ISP_EVENT_SYNC_SENSOR_ATTR, &sensor->video);
 	sensor->priv = wsize;
 
@@ -862,28 +890,12 @@
 
 static int sensor_set_vflip(struct tx_isp_subdev *sd, int enable)
 {
-	int ret = 0;
-	uint8_t val;
 	struct tx_isp_sensor *sensor = sd_to_sensor_device(sd);
+	int ret;
 
-	/* 2'b01:mirror,2'b10:filp */
-	val = sensor_read(sd, 0x3221, &val);
-	switch(enable) {
-	case 0:
-		sensor_write(sd, 0x3221, val & 0x99);
-		break;
-	case 1:
-		sensor_write(sd, 0x3221, val | 0x06);
-		break;
-	case 2:
-		sensor_write(sd, 0x3221, val | 0x60);
-		break;
-	case 3:
-		sensor_write(sd, 0x3221, val | 0x66);
-		break;
-	}
-
-	if(!ret)
+	flip_mode = enable & 3;
+	ret = sensor_apply_flip(sd);
+	if (!ret)
 		ret = tx_isp_call_subdev_notify(sd, TX_ISP_EVENT_SYNC_SENSOR_ATTR, &sensor->video);
 
 	return ret;
