#!/bin/sh
# Second ONVIF device for lens 2 (sensor 1: ch2/ch3) on its own IP.
# The IP is wlan0's address + 1 unless ALIAS_IP is set in
# /etc/default/onvif-lens2. Must run after S96onvif_discovery.

DAEMON="uhttpd-lens2"
PIDFILE="/var/run/uhttpd-lens2.pid"
WSD_PIDFILE="/run/wsd_simple_server_lens2.pid"
ARP_PIDFILE="/run/arp-lens2.pid"
DOCROOT="/var/www-lens2"
BASE_IF="wlan0"
ALIAS_IF="wlan0:1"
ALIAS_IP=""
EXTRA_PORT="8080"

[ -r /etc/default/onvif-lens2 ] && . /etc/default/onvif-lens2

base_cidr() {
	ip -4 addr show "$BASE_IF" 2>/dev/null |
		awk -v ifn="$BASE_IF" '$1 == "inet" && $NF == ifn { print $2; exit }'
}

pick_alias() {
	i=0
	cidr=$(base_cidr)
	while [ -z "$cidr" ] && [ $i -lt 30 ]; do
		sleep 1
		i=$((i + 1))
		cidr=$(base_cidr)
	done
	[ -n "$cidr" ] || return 1
	PREFIX=${cidr#*/}
	if [ -z "$ALIAS_IP" ]; then
		base=${cidr%/*}
		last=${base##*.}
		[ "$last" -lt 254 ] || return 1
		ALIAS_IP="${base%.*}.$((last + 1))"
	fi
	if ! arping -D -q -c 2 -I "$BASE_IF" "$ALIAS_IP" >/dev/null 2>&1; then
		echo "$DAEMON: $ALIAS_IP is already in use on the network"
		return 1
	fi
}

setup_docroot() {
	mkdir -p "$DOCROOT/onvif"
	chmod 755 "$DOCROOT" "$DOCROOT/onvif"
	for f in /var/www/onvif/*; do
		n=$(basename "$f")
		[ "$n" = onvif.json ] && continue
		if [ -L "$f" ] && [ "$(readlink "$f")" = onvif.cgi ]; then
			ln -sfn /var/www/onvif/onvif.cgi "$DOCROOT/onvif/$n"
		else
			ln -sfn "$f" "$DOCROOT/onvif/$n"
		fi
	done

	# GetProfiles hands out Profile_0/Profile_1 and GetStreamUri looks
	# profiles up by name, so the names must stay as they are.
	c="$DOCROOT/onvif/onvif.json"
	cp /etc/onvif.json "$c"
	jct "$c" set server.port 80 >/dev/null
	jct "$c" set server.ifs_override "$ALIAS_IF" >/dev/null
	jct "$c" set events_enable 0 >/dev/null
	jct "$c" set ptz.enable 0 >/dev/null
	jct "$c" set profiles.stream0.url 'rtsp://%s:554/ch2' >/dev/null
	jct "$c" set profiles.stream0.snapurl '' >/dev/null
	jct "$c" set profiles.stream1.url 'rtsp://%s:554/ch3' >/dev/null
	jct "$c" set profiles.stream1.snapurl '' >/dev/null
	jct "$c" del profiles.webrtc >/dev/null 2>&1
	chmod 644 "$c"
}

start() {
	[ -f /etc/onvif.json ] || {
		echo "$DAEMON: no /etc/onvif.json"
		return 1
	}
	pick_alias || {
		echo "$DAEMON: no usable address for $ALIAS_IF, not starting"
		return 1
	}
	ip addr add "$ALIAS_IP/$PREFIX" dev "$BASE_IF" label "$ALIAS_IF" 2>/dev/null
	# Wi-Fi extenders proxy ARP only for addresses they have learned.
	start-stop-daemon -S -q -b -m -p "$ARP_PIDFILE" -x /bin/sh -- -c \
		"while :; do arping -U -c 2 -I $BASE_IF -s $ALIAS_IP $ALIAS_IP >/dev/null 2>&1; sleep 300; done"
	setup_docroot
	echo -n "Starting $DAEMON on $ALIAS_IP:80 and :$EXTRA_PORT: "
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /usr/bin/uhttpd -- \
		-f -h "$DOCROOT" -x /x -t 0 -T 15 -k 10 -n 5 -N 20 \
		-p "$ALIAS_IP:80" -p "$EXTRA_PORT" && echo OK || echo FAIL
	# S96onvif_discovery sometimes loses a pidfile race ("Program is already
	# running") and the main responder exits; the alias responder relies on it.
	if ! ps | grep -q "[w]sd_simple_server -i $BASE_IF "; then
		echo -n "Starting wsd on $BASE_IF: "
		rm -f "/run/wsd_simple_server_$BASE_IF.pid"
		/usr/sbin/wsd_simple_server -i "$BASE_IF" -x "http://%s/onvif/device_service" \
			-n thingino -p "/run/wsd_simple_server_$BASE_IF.pid" && echo OK || echo FAIL
	fi
	echo -n "Starting wsd-lens2 on $ALIAS_IF: "
	/usr/sbin/wsd_simple_server -i "$ALIAS_IF" -x "http://%s/onvif/device_service" \
		-n thingino -p "$WSD_PIDFILE" -u && echo OK || echo FAIL
}

stop() {
	[ -f "$WSD_PIDFILE" ] && kill "$(cat "$WSD_PIDFILE")" 2>/dev/null
	rm -f "$WSD_PIDFILE"
	start-stop-daemon -K -q -p "$ARP_PIDFILE" 2>/dev/null
	rm -f "$ARP_PIDFILE"
	echo -n "Stopping $DAEMON: "
	start-stop-daemon -K -q -p "$PIDFILE" && rm -f "$PIDFILE" && echo OK || echo FAIL
	ip -4 addr show label "$ALIAS_IF" |
		awk '$1 == "inet" { print $2 }' |
		while read -r a; do ip addr del "$a" dev "$BASE_IF"; done
}

case "$1" in
start) start ;;
stop) stop ;;
restart)
	stop
	sleep 1
	start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
